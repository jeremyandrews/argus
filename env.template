# ===== WORKER CONFIGURATIONS =====
# Configure multiple workers for decision-making and analysis.
# Each worker can use either Ollama (local) or OpenAI (cloud) models.

# DECISION_OLLAMA_CONFIGS allows you to specify Ollama instances for decision-making.
# Format: host|port|model[/no_think] separated by ';'
# Add '/no_think' suffix to model name for non-thinking mode (faster, different parameters)
#
# Example Configuration:
# export DECISION_OLLAMA_CONFIGS="localhost|11434|llama3.1:70b-instruct-fp16;localhost|11434|qwen2.5:7b/no_think"

# ANALYSIS_OLLAMA_CONFIGS allows you to specify Ollama instances for analysis.
# Supports fallback configuration: main_host|main_port|main_model||fallback_host|fallback_port|fallback_model
#
# Example Configuration:
# export ANALYSIS_OLLAMA_CONFIGS="localhost|11434|llama3.1:70b||localhost|11435|qwen2.5:7b/no_think"

# DECISION_OPENAI_CONFIGS allows you to specify OpenAI API keys and models for decision-making.
# Format: api_key|model separated by ';'
#
# Example Configuration:
# export DECISION_OPENAI_CONFIGS="sk-XXXXX|gpt-4;sk-YYYYY|gpt-3.5-turbo"

# ANALYSIS_OPENAI_CONFIGS allows you to specify OpenAI API keys and models for analysis.
# Supports fallback configuration: main_api_key|main_model||fallback_api_key|fallback_model
#
# Example Configuration:
# export ANALYSIS_OPENAI_CONFIGS="sk-ZZZZZ|gpt-4||sk-AAAAA|gpt-3.5-turbo"

# ===== LLM PARAMETER OVERRIDES =====
# These override the automatic parameter selection for both thinking and non-thinking modes.
# If not set, the system uses optimized defaults based on model type.
#
# Automatic defaults:
# Thinking mode: temp=0.6, top_p=0.95, top_k=20, min_p=0.0
# Non-thinking mode: temp=0.7, top_p=0.8, top_k=20, min_p=0.0

# Override temperature (0.0-2.0). Controls randomness/creativity.
#export LLM_TEMPERATURE="0.8"

# Override Top-P (0.0-1.0). Controls diversity via nucleus sampling.
#export LLM_TOP_P="0.9"

# Override Top-K (integer). Limits consideration to K most likely tokens.
#export LLM_TOP_K="40"

# Override Min-P (0.0-1.0). Sets minimum probability threshold for tokens.
#export LLM_MIN_P="0.05"

# ===== OPENAI RATE LIMITING =====
# Configure rate limiting for OpenAI API calls to prevent hitting quota limits.
# These settings help you stay within your OpenAI tier limits and can be adjusted as your limits increase.

# Enable or disable OpenAI rate limiting (true/false)
export OPENAI_RATE_LIMIT_ENABLED="true"

# Requests per minute limit (default: 500 for Tier 1)
export OPENAI_RATE_LIMIT_RPM="500"

# Requests per day limit (default: 10000 for Tier 1)
export OPENAI_RATE_LIMIT_RPD="10000"

# Burst allowance - allows short bursts above the average rate (default: 10)
export OPENAI_RATE_LIMIT_BURST="10"

